# Copy this file to `.env.local` (recommended for Vite) or `.env`, then fill in real values.
# Restart `npm run dev` after changing env — Vite reads `VITE_*` only at startup.
#
# Where to get values (Supabase dashboard → your project):
#   Project Settings → API
#   - Project URL     → VITE_SUPABASE_URL   (must look like https://xxxxx.supabase.co)
#   - anon public key   → VITE_SUPABASE_ANON_KEY (long JWT-style string starting with eyJ...)
#
# Never put the service_role key in the frontend — only the anon key belongs here.
# Do not put keys or publishable tokens in VITE_SUPABASE_URL (common mistake).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Demo workspace seed: `public` (default, anonymized) or `internal` (full detail, trusted builds only).
# VITE_DEMO_SEED_PROFILE=public
