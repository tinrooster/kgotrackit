# Copy to `.env.local` (or `.env`) for Vite. Never commit real keys.
# Supabase: Project Settings → API → Project URL & anon public key.
# Do not swap: URL is always https://xxxx.supabase.co — never sb_publishable_… or eyJ… in VITE_SUPABASE_URL.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
