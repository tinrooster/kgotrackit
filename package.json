{
  "name": "trackit-v2",
  "private": true,
  "version": "1.0.1",
  "description": "trackIT v2: Vite, React, TypeScript web app",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "clean": "rimraf dist dist-web out .vite",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "check": "tsc --noEmit",
    "check:ci": "tsc --noEmit -p tsconfig.ci.json",
    "gate:ci": "npm run check:ci && npm run build",
    "build:web": "vite build",
    "preview:web": "vite preview",
    "baselines:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/baselines/Sync-Baselines.ps1",
    "baselines:compare": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/baselines/Compare-ToBaseline.ps1",
    "baselines:compare:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/baselines/Compare-ToBaseline.ps1 -Baseline local-trackIT",
    "start": "vite preview",
    "version:bump:patch": "node ./scripts/bump-minor-version.cjs",
    "commit:patch": "npm run version:bump:patch && git add package.json package-lock.json && git commit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^7.0.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^3.3.4",
    "@radix-ui/react-alert-dialog": "^1.1.11",
    "@radix-ui/react-avatar": "^1.1.7",
    "@radix-ui/react-checkbox": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.10",
    "@radix-ui/react-dropdown-menu": "^2.1.12",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.11",
    "@radix-ui/react-progress": "^1.1.4",
    "@radix-ui/react-scroll-area": "^1.2.6",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.4",
    "@radix-ui/react-slider": "^1.3.2",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.2.2",
    "@radix-ui/react-tabs": "^1.1.8",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.2.4",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "@tailwindcss/typography": "^0.5.10",
    "@types/uuid": "^10.0.0",
    "@zxing/library": "^0.20.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "cmdk": "^1.1.1",
    "date-fns": "^2.30.0",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.294.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.5",
    "react-hot-toast": "^2.5.2",
    "react-router-dom": "^6.22.1",
    "react-zxing": "^2.1.0",
    "recharts": "^2.15.3",
    "sonner": "^1.4.41",
    "tailwind-merge": "^1.14.0",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20.17.31",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "postcss": "^8.4.31",
    "rimraf": "^6.0.1",
    "typescript": "^5.3.2",
    "vite": "^5.0.0"
  }
}
